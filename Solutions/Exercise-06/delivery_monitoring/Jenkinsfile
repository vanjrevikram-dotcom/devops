pipeline {
    agent any
    stages {
        stage('Pre-check Docker') {
            steps {
                script {
                    try {
                        // Check if Docker is installed
                        def dockerVersion = sh(script: 'docker --version', returnStdout: true).trim()
                        if (!dockerVersion) {
                            error "Docker is not installed or not in the PATH. Please install Docker."
                        }

                        // Check if Docker daemon is running
                        def dockerInfo = sh(script: 'docker info', returnStatus: true)
                        if (dockerInfo != 0) {
                            error "Docker daemon is not running. Please start the Docker service."
                        }

                        echo "Docker is available and running: ${dockerVersion}"
                    } catch (Exception e) {
                        error "Pre-check failed: ${e.message}"
                    }
                }
            }
        }
        stage('Setup Workspace') {
            steps {
                script {
                    // Define the local source path where the files are located
                    // (the lab's Solutions folder is mounted read-only into the Jenkins container at /labs)
                    def localSourcePath = '/labs/Exercise-06/delivery_monitoring'
                    def workspacePath = env.WORKSPACE

                    // Copy necessary files into the Jenkins workspace
                    sh """
                    cp ${localSourcePath}/delivery_metrics.py ${workspacePath}/
                    cp ${localSourcePath}/prometheus.yml ${workspacePath}/
                    cp ${localSourcePath}/alert_rules.yml ${workspacePath}/
                    cp ${localSourcePath}/Dockerfile ${workspacePath}/
                    """
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                sh 'docker build -t delivery_metrics .'
            }
        }
        stage('Run Application') {
            steps {
                // remove a container left over from a previous build so the pipeline is re-runnable
                sh 'docker rm -f delivery_metrics || true'
                sh 'docker run -d -p 8000:8000 --name delivery_metrics delivery_metrics'
            }
        }
        stage('Run Prometheus & Grafana') {
            steps {
                // The workspace lives inside the Jenkins container, but 'docker run -v' paths are resolved
                // by the HOST daemon. Configs are therefore read from the host path of the same files.
                sh '''
                docker rm -f prometheus grafana || true
                docker run -d --name prometheus -p 9090:9090 \
                  -v $HOST_LAB_DIR/Exercise-06/delivery_monitoring/prometheus.yml:/etc/prometheus/prometheus.yml \
                  -v $HOST_LAB_DIR/Exercise-06/delivery_monitoring/alert_rules.yml:/etc/prometheus/alert_rules.yml \
                  prom/prometheus
                docker run -d --name grafana -p 3000:3000 grafana/grafana
                '''
            }
        }
        stage('Verify') {
            steps {
                sh '''
                sleep 20
                docker ps --format "table {{.Names}}\\t{{.Image}}\\t{{.Status}}\\t{{.Ports}}"
                docker exec prometheus wget -qO- "http://localhost:9090/api/v1/targets?state=active" | head -c 1500; echo
                '''
            }
        }
    }
}
